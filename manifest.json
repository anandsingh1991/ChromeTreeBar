{
  "manifest_version": 3,
  "name": "ChromeTreeBar",
  "version": "1.0.0",
  "description": "Manage Chrome tabs in a tree structure with drag-and-drop, tab groups, bookmarks integration, and instant search",
  "permissions": [
    "tabs",
    "sidePanel",
    "storage",
    "tabGroups",
    "favicon",
    "bookmarks"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "action": {
    "default_title": "Toggle ChromeBar Side Panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+C",
        "mac": "Alt+C"
      },
      "description": "Toggle side panel"
    }
  }
}
